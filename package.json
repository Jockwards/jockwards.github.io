{
	"name": "jocke-pa-internet",
	"version": "1.0.0",
	"description": "En modern men lite nördig blogg om kod, teknik och slumpmässiga tankar",
	"scripts": {
		"build:css": "tailwindcss -i src/assets/css/tailwind.css -o src/assets/css/bundle.css",
		"watch:css": "tailwindcss -i src/assets/css/tailwind.css -o src/assets/css/bundle.css --watch",
		"build:11ty": "npx @11ty/eleventy",
		"build": "npm run build:css && npm run build:11ty",
		"start": "npx @11ty/eleventy --serve",
		"dev": "concurrently -k \"npm run watch:css\" \"npx @11ty/eleventy --serve --watch\""
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"devDependencies": {
		"@11ty/eleventy": "^3.1.2",
		"@tailwindcss/cli": "^4.1.12",
		"concurrently": "^9.2.1",
		"tailwindcss": "^4.1.12"
	},
	"dependencies": {
		"@11ty/eleventy-img": "^7.0.0",
		"dotenv": "^17.2.3",
		"eleventy-plugin-embed-everything": "^1.21.0"
	},
	"type": "module"
}
