---
pagination:
  data: collections.tagList
  size: 1
  alias: tag
permalink: /tags/{{ tag | slug }}/
layout: base.njk
---
{% from "components/post-excerpt.njk" import postExcerpt %}

<section>
  <h2 class="section-header">Inlägg taggade med "{{ tag }}"</h2>

  {% set postsForTag = collections[tag] | reverse %}
  {% if postsForTag.length > 0 %}
  <div class="posts-container">
    {% for post in postsForTag %}
      {{ postExcerpt(post, 'h2') }}
    {% endfor %}
  </div>
  {% else %}
  <p>Inga inlägg hittades med denna tagg.</p>
  {% endif %}
</section>
