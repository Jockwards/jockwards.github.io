{% macro bookGridItem(book) %}
  <div class="book-item">
    <a href="https://hardcover.app/books/{{ book.slug }}" target="_blank" rel="noopener noreferrer" class="book-link">
      {% if book.cover %}
        <img src="{{ book.cover }}" alt="Omslag för {{ book.title }}" class="book-cover" loading="lazy" decoding="async" width="120" height="180" eleventy:ignore>
      {% else %}
        <div class="book-cover-placeholder">{{ book.title }}</div>
      {% endif %}
      <div class="book-info">
        <div class="book-title">{{ book.title }}</div>
        {% if book.authors.length > 0 %}
          <div class="book-author">{{ book.authors | join(', ') }}</div>
        {% endif %}
      </div>
    </a>
  </div>
{% endmacro %}

{% macro bookListItem(book, showPosition = false) %}
  <li class="book-list-item">
    <a href="https://hardcover.app/books/{{ book.slug }}" target="_blank" rel="noopener noreferrer" class="book-list-link">
      {% if book.cover %}
        <img src="{{ book.cover }}" alt="Omslag för {{ book.title }}" class="book-list-cover" loading="lazy" decoding="async" width="40" height="60" eleventy:ignore>
      {% endif %}
      <span class="book-list-title">
        {{ book.title }}{% if showPosition and book.seriesPosition %} (#{{ book.seriesPosition }}){% endif %}
      </span>
    </a>
  </li>
{% endmacro %}
