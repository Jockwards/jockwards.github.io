<!DOCTYPE html>
<html lang="sv">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title %}{{ title }} - {% endif %}{{ site.title }}</title>
  <meta name="description" content="{{ description or site.description }}">

  {% if canonicalUrl %}
    <link rel="canonical" href="{{ canonicalUrl }}">
  {% endif %}

  <link rel="alternate" type="application/rss+xml" title="{{ site.title }} RSS" href="{{ site.url }}{{ site.feedPath }}">
  <link rel="sitemap" type="application/xml" href="{{ site.url }}/sitemap.xml">
  <link rel="icon" type="image/svg+xml" href="/assets/favicon/jp-favicon.svg">

  <!-- Open Graph -->
  <meta property="og:title" content="{% if title %}{{ title }}{% else %}{{ site.title }}{% endif %}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:type" content="{% if page.url and page.url != '/' %}article{% else %}website{% endif %}">
  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:locale" content="sv_SE">
  {% if canonicalUrl %}
    <meta property="og:url" content="{{ canonicalUrl }}">
  {% endif %}
  <meta property="og:image" content="{{ site.url }}/assets/favicon/jp-favicon.svg">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{% if title %}{{ title }}{% else %}{{ site.title }}{% endif %}">
  <meta name="twitter:description" content="{{ description or site.description }}">
  <meta name="twitter:image" content="{{ site.url }}/assets/favicon/jp-favicon.svg">

  <link rel="stylesheet" href="/assets/css/bundle.css?v={{ build.cacheVersion }}">
  {% for file in extraCss or [] %}
    <link rel="stylesheet" href="/assets/css/{{ file }}?v={{ build.cacheVersion }}">
  {% endfor %}
</head>
<body>
  <script>
    (function () {
      var saved = localStorage.getItem('theme');
      var prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
      if (saved === 'light' || (!saved && prefersLight)) {
        document.body.classList.add('light-mode');
      }
    })();
  </script>
  <div class="main-container">
    <header class="header">
      <div class="header-top">
        <h1 class="site-title"><a href="/" class="site-title-link">{{ site.title }}</a></h1>
        <button class="theme-toggle" onclick="toggleTheme()" aria-label="Växla mellan ljust och mörkt tema">
          <span class="theme-icon" aria-hidden="true">🌙</span>
        </button>
      </div>
      <p class="site-subtitle">{{ site.description }}</p>

      <nav class="main-nav">
        <a href="/" class="nav-link {% if page.url == '/' %}active{% endif %}">Hem</a>
        <a href="/pages/blog/" class="nav-link {% if page.url == '/pages/blog/' %}active{% endif %}">Blogg</a>
        <a href="/pages/reading-list/" class="nav-link {% if page.url == '/pages/reading-list/' %}active{% endif %}">Läslista</a>
        <a href="{{ site.feedPath }}" class="nav-link {% if page.url == site.feedPath %}active{% endif %}">RSS</a>
      </nav>
    </header>

    <main>
      {{ content | safe }}
    </main>

    <footer class="footer">
      <p><span class="terminal-prompt">jocke@internet:~$</span> uptime: {% datetime %}</p>
    </footer>
  </div>

  <script>
    (function () {
      var themeIcon = document.querySelector('.theme-icon');
      if (document.body.classList.contains('light-mode') && themeIcon) {
        themeIcon.textContent = '☀️';
      }
    })();

    function toggleTheme() {
      var body = document.body;
      var themeIcon = document.querySelector('.theme-icon');
      var isLight = body.classList.toggle('light-mode');
      if (themeIcon) themeIcon.textContent = isLight ? '☀️' : '🌙';
      localStorage.setItem('theme', isLight ? 'light' : 'dark');
    }
  </script>
</body>
</html>
